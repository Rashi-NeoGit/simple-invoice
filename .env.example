# Used by docker-compose.yml to configure all three services.
# Copy to .env and adjust if needed before running `docker compose up`.

# --- Postgres ---
POSTGRES_USER=simpleinvoice
POSTGRES_PASSWORD=simpleinvoice
POSTGRES_DB=simpleinvoice
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=3600

# --- Frontend ---
FRONTEND_PORT=5173
# Base URL the frontend uses to reach the backend API (baked in at build time)
VITE_API_URL=http://localhost:3000
