# Copy to .env for local (non-Docker) development.
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=simpleinvoice
DATABASE_PASSWORD=simpleinvoice
DATABASE_NAME=simpleinvoice

JWT_SECRET=change-me-in-production
# Token expiry in seconds. Defaults to 3600 if unset.
JWT_EXPIRES_IN=3600
